# Copy to .env and fill in before running `docker compose up`

# atlas-core — HOST port for the app (both compose files). The app always listens on 8080 inside
# the container; this only changes the host side of the mapping. Override if 8080 is taken.
ATLAS_CORE_PORT=8080

# Production profile only (docker-compose.prod.yml): host port for the nginx UI ingress.
# Defaults to 80; override if another service already owns :80 on the host (a real prod boot
# collided here). The API is reached via this same ingress at <host>:$ATLAS_UI_PORT/api.
ATLAS_UI_PORT=80

# PostgreSQL 16 + pgvector (see docs/adr — embedding dimension couples the
# schema to the embedding model in use). atlas-core's SPRING_DATASOURCE_*
# vars are derived from these in docker-compose.yml.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=changeme
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# OpenAI API key for Spring AI embeddings (text-embedding-3-small — see EmbeddingConfig).
# Strictly from the environment: leave empty for local dev/CI (the embedding beans simply won't
# exist — see EmbeddingConfig's javadoc), fill in only in a real .env you don't commit. NEVER put
# a real key here or anywhere else in this repo.
SPRING_AI_OPENAI_API_KEY=

# API key required as the X-API-Key header on all /api/** endpoints (see ApiKeyAuthFilter).
# Strictly from the environment, like the OpenAI key above — never a default in application.yml.
# LEAVE EMPTY to run keyless (local dev / CI / quickstart): auth is DISABLED and a WARN is logged
# at startup. Set a value to require the header in production. The UI (gear icon), corpus/ingest.sh,
# and atlas-evals send it from this same variable when set.
ATLAS_API_KEY=

# Line-noise stripping applied to parsed page text before chunking (atlas.parsing.strip-line-
# patterns — see ParsingProperties). Empty by default: Atlas core is corpus-agnostic and ships
# no patterns of its own. The patterns below are demo config for the EU digital-regulation
# corpus (see corpus/README.md) — comma-separated, matched as a FULL line (a partial match doesn't
# strip the line), verified against the exact footer strings pulled from a corpus spot check:
#   1. Old EUR-Lex OJ-style footer, fields in any order, e.g.
#      "4.5.2016 L 119/39 Official Journal of the European Union EN"
#   2. New EUR-Lex ELI-style footer, line 1, leading EN, e.g. "EN OJ L, 12.7.2024"
#   3. New EUR-Lex ELI-style footer, line 2, e.g.
#      "46/144 ELI: http://data.europa.eu/eli/reg/2024/1689/oj"
#   4. New EUR-Lex ELI-style footer, line 1, TRAILING EN, e.g. "OJ L, 12.7.2024 EN"
#      — the same fields as #2 but with EN at the end. Found later (259 chunks) after #2 was
#      already in place; pattern 2 only anchors the leading-EN form. APPLY ON NEXT RE-INGEST
#      (present in the value below so a fresh ingest strips it; the current corpus ingest is left
#      as-is because the mini-golden dataset pins its chunk indexes — see corpus/README.md).
# No literal commas appear in any pattern (note \d\d? instead of \d{1,2}, and .? to match the
# footer's own comma) since a literal comma would be misread as a boundary between list entries.
ATLAS_PARSING_STRIP_LINE_PATTERNS=^(?=.*Official Journal of the European Union)(?=.*\bEN\b)(?=.*L\s*\d+/\d+)(?=.*\d\d?\.\d\d?\.\d{4}).*$,^EN OJ L.? \d\d?\.\d\d?\.\d{4}$,.*ELI: http://data\.europa\.eu/eli/.*,^OJ L.? \d\d?\.\d\d?\.\d{4} EN$
